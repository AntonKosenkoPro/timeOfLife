{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "explore": {
      "model": "ollama-cloud/glm-5.3-flash",
      "reasoningEffort": "high"
    },
    "build": {
      "model": "ollama-cloud/deepseek-v4-flash",
      "reasoningEffort": "max"
    },
    "general": {
      "model": "ollama-cloud/glm-5.3-flash",
      "reasoningEffort": "high"
    },
    "plan": {
      "model": "opencode-go/kimi-k3",
      "reasoningEffort": "max",
      "permission": {
        "argent*": "deny"
      }
    }
  },
  "mcp": {
    "argent": {
      "type": "local",
      "command": [
        "argent",
        "mcp"
      ],
      "enabled": true
    }
  },
  "subagent_depth": 2,
  "tools": {
    "argent*": true
  }
}
