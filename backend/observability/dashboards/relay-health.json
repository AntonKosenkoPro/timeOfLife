        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(http_server_requests_total{service_name=\"lifio-backend\",http_status_class=\"5xx\"}[5m])) / sum by (operation) (rate(http_server_requests_total{service_name=\"lifio-backend\"}[5m]))",
          "refId": "A"
        }
