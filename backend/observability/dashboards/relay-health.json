      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_requests_total{service_name=\"lifio-backend\"}[5m]))",
          "refId": "A"
