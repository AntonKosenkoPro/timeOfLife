        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "DS_PROMETHEUS"
      }
    ]
  },
  "timezone": "browser",
  "title": "Lifio 1 \u2014 Relay health",
  "uid": "lifio-relay-health",
  "version": 1,
  "panels": [
